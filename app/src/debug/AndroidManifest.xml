<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only overlay.

    Since Android 9 cleartext HTTP is blocked by default, and this app targets
    SDK 35, so a plain `http://192.168.x.x:4000/` dev server is unreachable
    without an opt-in. That opt-in lives here, in the debug source set alone:
    release builds keep the secure default, because a flag that permits
    unencrypted traffic is exactly the kind of thing that gets added "just for
    testing" and then ships.

    It matters more since boundary creation moved out of the app - with no way to
    make a plot locally, an unreachable API means an empty screen.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:usesCleartextTraffic="true"
        tools:targetApi="28" />
</manifest>
